# ── LLM ─────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_AVAILABLE_MODELS=gpt-5.4-mini,gpt-4o-mini
INVENTORY_MAVEN_ENRICHMENT_ENABLED=true
INVENTORY_DEEP_AGENT_ENABLED=true
INVENTORY_CONFIDENCE_THRESHOLD=0.85
PLAN_DEEP_AGENT_ENABLED=true
PLAN_CONFIDENCE_THRESHOLD=0.85
LLM_BASE_URL=
LLM_MAX_TOKENS=4096
LLM_MONTHLY_BUDGET_USD=500

# ── 임베딩(RAG) — 예약, 미구현 ───────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# ── 취약점 스캔(SCA) ────────────────
NVD_API_KEY=
DEPENDENCY_CHECK_DATA_DIR=./data/nvd-cache
TRIVY_CACHE_DIR=./data/trivy-cache

# ── Git / 형상관리 ──────────────────
GIT_TOKEN=
GIT_SSH_KEY_PATH=
GIT_AUTHOR_NAME=upgrade-agent
GIT_AUTHOR_EMAIL=upgrade-agent@example.com

# ── 아티팩트 저장소(Nexus) — 예약, 미구현 ─
NEXUS_URL=
NEXUS_USERNAME=
NEXUS_PASSWORD=

# ── Maven 공개 미러 대체 (사외에서 실행, 사내 Nexus 접근 불가 시) ──
# 대상 프로젝트 pom.xml이 사내 Nexus를 <repository>로 선언해도, true로 켜면
# 모든 저장소 조회를 아래 공개 URL로 리다이렉트하는 settings.xml을 만들어
# mvn 호출마다 -s로 넘긴다. 사내망(VPN 등)에서 돌릴 땐 false로 두는 게 기본.
MVN_PUBLIC_MIRROR_ENABLED=false
MVN_PUBLIC_MIRROR_URL=https://repo.maven.apache.org/maven2

# ── 앱 보안 ─────────────────────────
APP_SECRET_KEY=
API_AUTH_TOKEN=

# ── DB / 작업 데이터 ────────────────
DATABASE_URL=sqlite:///./data/app.db
JOBS_DATA_DIR=./data/jobs

# ── 알림 — 예약, 미구현 ──────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ── 네트워크(사내망) ────────────────
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ── 실행 한도/안전장치 ──────────────
MAX_CONCURRENT_REPOS=3
FAIL_ON_CVSS=7.0
BUILD_TIMEOUT_SECONDS=900
COMPILE_FIXER_ENABLED=true
COMPILE_FIX_MAX_ATTEMPTS=2
COMPILE_FIX_AUTO_APPLY_MAX_FILES=3
# 카탈로그에 레시피가 없어 AI가 버전 업그레이드를 처음부터 시도하는 스텝 전용
# 한도 -- 컴파일 에러 하나만 고치는 것보다 훨씬 많은 파일을 건드리는 게 정상이라
# 위 COMPILE_FIX_AUTO_APPLY_MAX_FILES보다 넉넉하게 잡는다.
COMPILE_FIX_AUTO_APPLY_MAX_FILES_NO_RECIPE=20
UPLOAD_MAX_MB=100
UPLOAD_MAX_EXTRACTED_MB=500
UPLOAD_MAX_FILES=20000

# ── CI/CD 연동 — 예약, 미구현 ────────
CI_TRIGGER_TOKEN=

# ── LangSmith ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=poscodx_tracing
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 서버 실행 ─────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5500
